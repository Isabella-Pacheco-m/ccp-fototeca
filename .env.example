# ------------------------------------------------------------------ Django --
SECRET_KEY=cambia-esto-por-una-cadena-larga-y-aleatoria
DEBUG=False
ALLOWED_HOSTS=fototeca.ccpalmira.org.co
SITE_URL=https://fototeca.ccpalmira.org.co
CSRF_TRUSTED_ORIGINS=https://fototeca.ccpalmira.org.co

# ------------------------------------------------------- Postgres (Railway) --
# Dentro de Railway basta con referenciar la variable del servicio Postgres.
# En local usa la URL pública (Railway → Postgres → Connect → Public Network).
DATABASE_URL=postgresql://usuario:clave@host:puerto/base
DB_SSL_REQUIRE=True

# --------------------------------------------------------- Supabase (Auth) --
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_PUBLIC=eyJhbGciOi...
SUPABASE_SERVICE_ROLE=eyJhbGciOi...

# ---------------------------------------------------------- Enlace mágico --
# supabase = el correo lo envía Supabase Auth
# local    = lo envía Django por SMTP (o por consola si DEBUG=True)
MAGIC_LINK_BACKEND=supabase
MAGIC_LINK_TTL_MINUTOS=20
MAGIC_LINK_MAX_SOLICITUDES=5
MAGIC_LINK_VENTANA_MINUTOS=15

# ------------------------------------------------- SMTP (backend "local") --
EMAIL_HOST=smtp.tuproveedor.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Fototeca CCP <no-responder@ccpalmira.org.co>

# ------------------------------------------------------------------ Galería --
# True deja la galería abierta al público; False exige enlace mágico.
GALERIA_PUBLICA=False
IMAGEN_TAMANIO_MAXIMO_MB=12
IMAGEN_ANCHO_MAXIMO=2400
MINIATURA_ANCHO=640

# --------------------------------------------- Superadministrador inicial --
ADMIN_CORREO=admin@ccpalmira.org.co
ADMIN_CLAVE=
ADMIN_NOMBRE=Superadministrador
